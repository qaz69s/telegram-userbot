# ── 从 https://my.telegram.org/apps 获取 ──────────────────
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ── 登录账号（auth.py 自动写入，支持多账号逗号分隔） ────────
# 示例: PHONES='+8613812345678,+8619900000000'
PHONES=

# ── 数据目录（无需修改） ─────────────────────────────────────
DB_PATH=data/bot.db
SESSION_DIR=sessions
# ── 命令前缀（默认 #，可改为 / ! . 等） ─────────────────
CMD_PREFIX=#